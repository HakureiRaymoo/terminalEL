<Page x:Class="Microsoft.Terminal.Settings.Editor.GlobalAppearance"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:model="using:Microsoft.Terminal.Settings.Model"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="EnumComboBoxTemplate"
                          x:DataType="local:EnumEntry">
                <TextBlock Text="{x:Bind EnumName, Mode=OneWay}" />
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Style="{StaticResource SettingsStackStyle}" GotFocus="TFELNumber_GotFocus">
        <local:SettingsCard x:Uid="IMECandidateOverlayCard">
            <ToggleSwitch x:Uid="IMECandidateOverlaySwitch" IsOn="{x:Bind ViewModel.IMECandidateOverlay, Mode=TwoWay}" />
        </local:SettingsCard>

        <local:SettingsCard x:Uid="IMECandidateGlowCard">
            <ToggleSwitch x:Uid="IMECandidateGlowSwitch" IsOn="{x:Bind ViewModel.IMECandidateGlow, Mode=TwoWay}" />
        </local:SettingsCard>
        <!--  Section: Visual style  -->
        <TextBlock x:Uid="Globals_Section_VisualStyle"
                   Margin="0,20,0,4"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <!--  Theme  -->
        <local:SettingsExpander x:Name="Theme"
                                x:Uid="Globals_Theme"
                                IsExpanded="True">
            <local:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE790;" />
            </local:SettingsExpander.HeaderIcon>
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemsSource="{x:Bind ViewModel.ThemeList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentTheme, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="model:Theme">
                        <TextBlock Text="{x:Bind local:GlobalAppearanceViewModel.ThemeNameConverter((model:Theme)), Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <local:SettingsExpander.Items>
                <!--  Show Acrylic in Tab Row  -->
                <local:SettingsCard x:Name="AcrylicTabRow"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_AcrylicTabRow"
                              IsChecked="{x:Bind ViewModel.UseAcrylicInTabRow, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--  Enable Unfocused Acrylic  -->
                <local:SettingsCard x:Name="EnableUnfocusedAcrylic"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_EnableUnfocusedAcrylic"
                              IsChecked="{x:Bind ViewModel.EnableUnfocusedAcrylic, Mode=TwoWay}" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <!-- terminalEL display model -->
        <TextBlock x:Uid="TFELHybridHelp" TextWrapping="Wrap" />
        <local:SettingsCard x:Uid="TFELModeCard">
            <ComboBox SelectedIndex="{x:Bind ViewModel.TFELModeIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="TFELModeMono" />
                <ComboBoxItem x:Uid="TFELModeNative" />
                <ComboBoxItem x:Uid="TFELModeTinted" />
                <ComboBoxItem x:Uid="TFELModeHybrid" />
            </ComboBox>
        </local:SettingsCard>
        <local:SettingsCard x:Uid="TFELPanelGridCard">
            <StackPanel Width="240">
                <Slider x:Uid="TFELPanelGridInput" Minimum="0" Maximum="0.15" StepFrequency="0.01" Value="{x:Bind ViewModel.TFELPanelGrid, Mode=TwoWay}" />
                <muxc:NumberBox x:Uid="TFELPanelGridInput" Minimum="0" Maximum="0.15" SmallChange="0.01" Tag="TFELPanelGrid" Value="{x:Bind ViewModel.TFELPanelGrid, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
            </StackPanel>
        </local:SettingsCard>
        <TextBlock x:Uid="TFELCalibrationHelp" TextWrapping="Wrap" />
        <local:SettingsCard x:Uid="TFELPresetCard">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.TFELCurrentPresetStatus, Mode=OneWay}" MaxWidth="300" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <ComboBox x:Name="TFELPresetPicker" x:Uid="TFELPresetPickerLabel" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="TFELApply" Click="ApplyTFELPreset_Click" />
                    <Button x:Uid="TFELExport" Click="ExportTFELPreset_Click" />
                    <Button x:Uid="TFELImport" Click="ImportTFELPreset_Click" />
                </StackPanel>
                <TextBox x:Name="TFELPresetName" x:Uid="TFELPresetNameLabel" MaxLength="80" />
                <Button x:Uid="TFELCreate" Click="CreateTFELPreset_Click" />
                <Button x:Uid="TFELUpdate" Click="UpdateTFELPreset_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="TFELRename" Click="RenameTFELPreset_Click" />
                    <Button x:Uid="TFELDelete" Click="DeleteTFELPreset_Click" />
                </StackPanel>
                <TextBlock x:Name="TFELPresetStatus" MaxWidth="300" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </local:SettingsCard>
        <local:SettingsExpander x:Uid="TFELColor">
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Uid="TFELHueCard">
                    <StackPanel>
                        <Slider x:Uid="TFELHueInput" Width="240" Minimum="-180" Maximum="180" StepFrequency="1" Value="{x:Bind ViewModel.TFELHue, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELHueInput" Minimum="-180" Maximum="180" SmallChange="1" Tag="TFELHue" Value="{x:Bind ViewModel.TFELHue, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="TFELSaturationCard">
                    <StackPanel>
                        <Slider x:Uid="TFELSaturationInput" Width="240" Minimum="0" Maximum="2" StepFrequency="0.01" Value="{x:Bind ViewModel.TFELSaturation, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELSaturationInput" Minimum="0" Maximum="2" SmallChange="0.01" Tag="TFELSaturation" Value="{x:Bind ViewModel.TFELSaturation, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="TFELIndependentCard">
                    <ToggleSwitch x:Uid="TFELIndependentInput" IsOn="{x:Bind ViewModel.TFELIndependentGlow, Mode=TwoWay}" />
                </local:SettingsCard>
                <local:SettingsCard x:Uid="TFELGlowHueCard">
                    <StackPanel>
                        <Slider x:Uid="TFELGlowHueInput" Width="240" Minimum="0" Maximum="360" StepFrequency="1" Value="{x:Bind ViewModel.TFELGlowHue, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELGlowHueInput" Minimum="0" Maximum="360" SmallChange="1" Tag="TFELGlowHue" Value="{x:Bind ViewModel.TFELGlowHue, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="TFELGlowSaturationCard">
                    <StackPanel>
                        <Slider x:Uid="TFELGlowSaturationInput" Width="240" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.TFELGlowSaturation, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELGlowSaturationInput" Minimum="0" Maximum="1" SmallChange="0.01" Tag="TFELGlowSaturation" Value="{x:Bind ViewModel.TFELGlowSaturation, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="TFELGlowMixCard">
                    <StackPanel>
                        <Slider x:Uid="TFELGlowMixInput" Width="240" Minimum="0" Maximum="1" StepFrequency="0.01" Value="{x:Bind ViewModel.TFELGlowMix, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELGlowMixInput" Minimum="0" Maximum="1" SmallChange="0.01" Tag="TFELGlowMix" Value="{x:Bind ViewModel.TFELGlowMix, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>
        <TextBlock x:Uid="Globals_Section_TerminalEL"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <local:SettingsExpander x:Name="TerminalELTone"
                                x:Uid="Globals_TerminalELTone"
                                IsExpanded="True">
            <local:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE706;" />
            </local:SettingsExpander.HeaderIcon>
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Uid="Globals_TFELBrightness">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBrightnessInput" Minimum="0"
                                Maximum="2"
                                StepFrequency="0.05"
                                Value="{x:Bind ViewModel.TFELBrightness, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBrightnessInput" Minimum="0" Maximum="2" SmallChange="0.05" Tag="TFELBrightness" Value="{x:Bind ViewModel.TFELBrightness, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELContrast">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELContrastInput" Minimum="0"
                                Maximum="2"
                                StepFrequency="0.05"
                                Value="{x:Bind ViewModel.TFELContrast, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELContrastInput" Minimum="0" Maximum="2" SmallChange="0.05" Tag="TFELContrast" Value="{x:Bind ViewModel.TFELContrast, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELBlackLevel">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBlackLevelInput" Minimum="0"
                                Maximum="0.5"
                                StepFrequency="0.01"
                                Value="{x:Bind ViewModel.TFELBlackLevel, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBlackLevelInput" Minimum="0" Maximum="0.5" SmallChange="0.01" Tag="TFELBlackLevel" Value="{x:Bind ViewModel.TFELBlackLevel, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELGamma">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELGammaInput" Minimum="0.5"
                                Maximum="2.5"
                                StepFrequency="0.05"
                                Value="{x:Bind ViewModel.TFELGamma, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELGammaInput" Minimum="0.5" Maximum="2.5" SmallChange="0.05" Tag="TFELGamma" Value="{x:Bind ViewModel.TFELGamma, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <local:SettingsExpander x:Name="TerminalELBloom"
                                x:Uid="Globals_TerminalELBloom"
                                IsExpanded="True">
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Uid="Globals_TFELBloomIntensity">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBloomIntensityInput" Minimum="0"
                                Maximum="2"
                                StepFrequency="0.05"
                                Value="{x:Bind ViewModel.TFELBloomIntensity, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBloomIntensityInput" Minimum="0" Maximum="2" SmallChange="0.05" Tag="TFELBloomIntensity" Value="{x:Bind ViewModel.TFELBloomIntensity, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELBloomThreshold">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBloomThresholdInput" Minimum="0"
                                Maximum="1"
                                StepFrequency="0.01"
                                Value="{x:Bind ViewModel.TFELBloomThreshold, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBloomThresholdInput" Minimum="0" Maximum="1" SmallChange="0.01" Tag="TFELBloomThreshold" Value="{x:Bind ViewModel.TFELBloomThreshold, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELBloomRadius">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBloomRadiusInput" Minimum="0"
                                Maximum="16"
                                StepFrequency="0.5"
                                Value="{x:Bind ViewModel.TFELBloomRadius, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBloomRadiusInput" Minimum="0" Maximum="16" SmallChange="0.5" Tag="TFELBloomRadius" Value="{x:Bind ViewModel.TFELBloomRadius, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
                <local:SettingsCard x:Uid="Globals_TFELBloomSoftness">
                    <StackPanel Width="240">
                        <Slider x:Uid="TFELBloomSoftnessInput" Minimum="0"
                                Maximum="0.5"
                                StepFrequency="0.01"
                                Value="{x:Bind ViewModel.TFELBloomSoftness, Mode=TwoWay}" />
                        <muxc:NumberBox x:Uid="TFELBloomSoftnessInput" Minimum="0" Maximum="0.5" SmallChange="0.01" Tag="TFELBloomSoftness" Value="{x:Bind ViewModel.TFELBloomSoftness, Mode=OneWay}" ValueChanged="TFELNumber_ValueChanged" />
                    </StackPanel>
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <!--  Disable Animations  -->
        <!--  NOTE: the UID is "DisablePaneAnimationsReversed" not "DisablePaneAnimations". See GH#9124 for more details.  -->
        <local:SettingsCard x:Name="DisableAnimations"
                            x:Uid="Globals_DisableAnimationsReversed">
            <local:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE89F;" />
            </local:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.InvertedDisableAnimations, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingsCard>

        <!--  Section: Tabs and layout  -->
        <TextBlock x:Uid="Globals_Section_TabsLayout"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <!--  Title bar properties  -->
        <local:SettingsExpander x:Name="TitlebarProperties"
                                x:Uid="Globals_TitlebarProperties"
                                IsExpanded="True">
            <local:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE737;" />
            </local:SettingsExpander.HeaderIcon>
            <local:SettingsExpander.Items>

                <!--  Hide the title bar  -->
                <local:SettingsCard x:Name="ShowTitlebar"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_ShowTitlebar"
                              Click="{x:Bind ViewModel.ShowTitlebarToggled}"
                              IsChecked="{x:Bind ViewModel.ShowTabsInTitlebar, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--  Always show tabs  -->
                <local:SettingsCard x:Name="AlwaysShowTabs"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_AlwaysShowTabs"
                              IsChecked="{x:Bind ViewModel.AlwaysShowTabs, Mode=TwoWay}"
                              IsEnabled="{x:Bind mtu:Converters.InvertBoolean(ViewModel.ShowTabsInTitlebar), Mode=OneWay}" />
                </local:SettingsCard>

                <!--  Show tabs in full screen  -->
                <local:SettingsCard x:Name="ShowTabsFullscreen"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_ShowTabsFullscreen"
                              IsChecked="{x:Bind ViewModel.ShowTabsFullscreen, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--  Show Title in Titlebar (use active terminal title as application title)  -->
                <local:SettingsCard x:Name="ShowTitleInTitlebar"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_ShowTitleInTitlebar"
                              IsChecked="{x:Bind ViewModel.ShowTitleInTitlebar, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--  Show Admin Shield  -->
                <local:SettingsCard x:Name="ShowAdminShield"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_ShowAdminShield"
                              IsChecked="{x:Bind ViewModel.ShowAdminShield, Mode=TwoWay}" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <!--  Position of new tab  -->
        <local:SettingsCard x:Name="NewTabPosition"
                            x:Uid="Globals_NewTabPosition">
            <local:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xECC8;" />
            </local:SettingsCard.HeaderIcon>
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                      ItemsSource="{x:Bind ViewModel.NewTabPositionList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentNewTabPosition, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}" />
        </local:SettingsCard>

        <!--  Tab Width Mode  -->
        <local:SettingsCard x:Name="TabWidthMode"
                            x:Uid="Globals_TabWidthMode">
            <local:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE75D;" />
            </local:SettingsCard.HeaderIcon>
            <ComboBox AutomationProperties.AccessibilityView="Content"
                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                      ItemsSource="{x:Bind ViewModel.TabWidthModeList, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentTabWidthMode, Mode=TwoWay}"
                      Style="{StaticResource ComboBoxSettingStyle}" />
        </local:SettingsCard>

        <!--  Section: Window behavior  -->
        <TextBlock x:Uid="Globals_Section_WindowBehavior"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <!--  Always on Top  -->
        <local:SettingsCard x:Name="AlwaysOnTop"
                            x:Uid="Globals_AlwaysOnTop">
            <local:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE718;" />
            </local:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.AlwaysOnTop, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingsCard>

        <!--  Automatically hide window  -->
        <local:SettingsCard x:Name="AutoHideWindow"
                            x:Uid="Globals_AutoHideWindow">
            <local:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xED1A;" />
            </local:SettingsCard.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.AutoHideWindow, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
        </local:SettingsCard>

        <!--  Section: System integration & notifications  -->
        <TextBlock x:Uid="Globals_Section_SystemIntegration"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <!--  Always Show Notification Icon  -->
        <local:SettingsExpander x:Name="AlwaysShowNotificationIcon"
                                x:Uid="Globals_AlwaysShowNotificationIcon"
                                IsExpanded="True">
            <local:SettingsExpander.HeaderIcon>
                <FontIcon Glyph="&#xE944;" />
            </local:SettingsExpander.HeaderIcon>
            <ToggleSwitch IsOn="{x:Bind ViewModel.AlwaysShowNotificationIcon, Mode=TwoWay}"
                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            <local:SettingsExpander.Items>

                <!--  Minimize To Notification Area  -->
                <local:SettingsCard x:Name="MinimizeToNotificationArea"
                                    ContentAlignment="Left">
                    <CheckBox x:Uid="Globals_MinimizeToNotificationArea"
                              IsChecked="{x:Bind ViewModel.MinimizeToNotificationArea, Mode=TwoWay}" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>
    </StackPanel>
</Page>
